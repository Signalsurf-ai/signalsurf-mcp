{
  "name": "@signalsurf/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "SignalSurf MCP server for agent access to Workflows and workspace tables.",
  "type": "module",
  "bin": {
    "signalsurf-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @signalsurf/mcp-contract build && tsc -p tsconfig.json",
    "check:pr": "pnpm check:surfer-parity && pnpm check:schema-usage && pnpm check:contract && pnpm typecheck && pnpm test && pnpm build",
    "check:contract": "pnpm --filter @signalsurf/mcp-contract build",
    "check:schema-usage": "node scripts/check-schema-usage.mjs",
    "check:surfer-parity": "node scripts/check-surfer-parity.mjs",
    "deploy": "pnpm --filter @signalsurf/mcp-contract build && npx wrangler@4 deploy",
    "dev": "tsx src/index.ts",
    "generate:hosted-contract": "tsx scripts/generate-hosted-tool-catalog.ts",
    "start": "node dist/index.js",
    "test": "pnpm --filter @signalsurf/mcp-contract build && vitest run",
    "typecheck": "pnpm --filter @signalsurf/mcp-contract typecheck && tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@signalsurf/mcp-contract": "workspace:*",
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "packageManager": "pnpm@10.0.0"
}
